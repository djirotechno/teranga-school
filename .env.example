# ===================================================
# Téranga S'cool - Exemple de variables d'environnement
# Copiez ce fichier vers .env.local et renseignez vos clés
# ===================================================

# Configuration de base de l'application
NEXT_PUBLIC_APP_NAME="Téranga S'cool"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase (Auth, PostgreSQL, Storage)
NEXT_PUBLIC_SUPABASE_URL="https://votre-projet.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Clé serveur uniquement (webhooks PayTech / tâches admin) - ne jamais exposer côté client
SUPABASE_SERVICE_ROLE_KEY=""

# Paiements (Wave / Orange Money / PayTech)
PAYTECH_API_KEY=""
PAYTECH_API_SECRET=""
